{
  "printWidth": 100,
  "singleQuote": true,
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "parser": "angular"
      }
    },
    {
      "comment": "src/shared được nhân bản y hệt sang nexus-be, mà hai repo có printWidth khác nhau. Phải ghim cùng một cấu hình ở đây và ở nexus-be/.prettierrc, nếu không mỗi bên format ra một kiểu và check:shared sẽ luôn báo lệch.",
      "files": "src/shared/**/*.ts",
      "options": {
        "printWidth": 100,
        "singleQuote": true,
        "trailingComma": "all"
      }
    }
  ]
}
